# 安装到 /etc/counselor/training.env，root:counselor 0640。
# systemd EnvironmentFile 格式；不要在这里放人员初始密码。
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
ENABLE_DEV_LOGIN=0
TRUST_PROXY=loopback
DB_PATH=/var/lib/counselor/training.db
UPLOAD_DIR=/var/lib/counselor/uploads
BACKUP_DIR=/var/backups/counselor
LISTEN_BACKLOG=2048
