.record-filters {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.filter {
  flex: 1;
  padding: 16rpx 0;
  border-radius: 12rpx;
  text-align: center;
  font-size: 26rpx;
  background: #fff;
  color: #64748b;
}
.filter.active {
  background: #25489c;
  color: #fff;
}
.record-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}
.record-header .title {
  flex: 1;
  min-width: 0;
}
.review-state {
  flex-shrink: 0;
  font-size: 23rpx;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  background: #eef1f8;
  color: #64748b;
}
.review-state.approved {
  color: #167344;
  background: #e6f5ec;
}
.review-state.pending,
.review-state.unsubmitted {
  color: #9a641a;
  background: #fff3dc;
}
.review-state.rejected {
  color: #bc3434;
  background: #fdeaea;
}

.review-state.withdrawn { color: #64748b; background: #eef1f8; }
