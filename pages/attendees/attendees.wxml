<view class="page-shell">
  <navigation-bar title="报名人员" back="{{true}}"></navigation-bar>
  <scroll-view scroll-y class="screen">
    <view class="container">
      <status-panel
        loading="{{loading}}"
        error-message="{{errorMessage}}"
        bindretry="load"
      ></status-panel>
      <view class="title" wx:if="{{activity}}">{{activity.title}}</view>
      <navigator class="card" url="/pages/attendance-manage/attendance-manage?id={{activity.id}}" wx:if="{{activity}}">开放签到 / 签退与查看现场记录 ›</navigator>
      <view class="muted" wx:if="{{activity && !canConfirm}}">
        {{activity.status === 'cancelled' ? '活动已取消，保留历史报名记录' :
        '活动开始后可确认参加'}}
      </view>
      <view class="card" wx:for="{{attendees}}" wx:key="id">
        <view class="title">{{item.name}} · {{item.department}}</view>
        <view class="muted">工号：{{item.id}}　报名：{{item.registeredText}}</view>
        <view class="line" wx:if="{{item.confirmedAt}}">已确认参加</view>
        <button
          class="button-mini"
          wx:else
          size="mini"
          data-id="{{item.id}}"
          bindtap="confirm"
          disabled="{{confirming || loading || !canConfirm}}"
        >
          确认参加
        </button>
      </view>
      <view class="muted" wx:if="{{!loading && !errorMessage && !attendees.length}}">
        暂无报名人员
      </view>
    </view>
  </scroll-view>
</view>
