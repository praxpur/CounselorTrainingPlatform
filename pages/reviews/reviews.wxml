<view class="page-shell">
  <navigation-bar title="培训经历审核" back="{{true}}"></navigation-bar>
  <scroll-view scroll-y class="screen">
    <view class="container">
      <status-panel
        loading="{{loading}}"
        error-message="{{errorMessage}}"
        bindretry="load"
      ></status-panel>
      <view class="page-toolbar" wx:if="{{!loading && !errorMessage}}">
        <view class="review-heading">
          <view class="title">待审批</view>
          <text class="review-badge">{{pendingCount}}</text>
        </view>
        <button size="mini" class="button-mini" bindtap="toggleRecords">
          {{showAll ? '只看待审批' : '查看全部'}}
        </button>
      </view>
      <view class="card" wx:for="{{records}}" wx:key="id">
        <view class="title">{{item.title}}</view>
        <view class="muted">{{item.name}} · {{item.department}} · {{item.userId}}</view>
        <view class="line">{{item.description}}</view>
        <view class="muted" wx:if="{{item.external}}">自行参加 · {{item.organizer}} · {{item.occurredOn}} · 申请 {{item.requestedHours}} 学时</view>
        <proof-files files="{{item.proofs}}"></proof-files>
        <block wx:if="{{item.status === 'pending'}}">
          <input wx:if="{{item.external}}" type="digit" placeholder="认定学时（两位小数）" value="{{hours[item.id] === undefined ? item.requestedHours : hours[item.id]}}" data-id="{{item.id}}" bindinput="inputHours" />
          <input
            maxlength="500"
            placeholder="审核意见（驳回时必填）"
            data-id="{{item.id}}"
            bindinput="input"
          />
          <button
            class="button-mini"
            size="mini"
            data-id="{{item.id}}"
            data-status="approved"
            bindtap="review"
          >
            通过
          </button>
          <button
            class="button-mini"
            size="mini"
            data-id="{{item.id}}"
            data-status="rejected"
            bindtap="review"
          >
            驳回
          </button>
        </block>
        <view wx:else class="muted">
          {{item.status === 'approved' ? '已通过' : '已驳回'}}　{{item.reviewNote}}
        </view>
      </view>
      <view class="muted" wx:if="{{!loading && !errorMessage && !records.length}}">
        {{showAll ? '暂无培训经历' : '暂无待审批记录'}}
      </view>
      <view class="muted" wx:if="{{windowed}}">当前显示第 {{displayFrom}}—{{displayTo}} 条，可返回上一页。</view>
      <button wx:if="{{previousOffset !== null && previousOffset !== undefined}}" bindtap="previous" disabled="{{loading || busy || uploading}}">上一页</button>
      <button wx:if="{{hasMore}}" bindtap="more" disabled="{{loading || busy || uploading}}">加载更多审核记录</button>
    </view>
  </scroll-view>
</view>
