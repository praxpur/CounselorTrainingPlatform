<view class="page-shell">
  <navigation-bar title="我的培训经历" back="{{true}}"></navigation-bar>
  <scroll-view scroll-y class="screen">
    <view class="container">
      <view class="card">
        <view class="title">提交培训经历</view>
        <view class="muted">选择已报名的活动，填写经历并提交管理员审核。</view>
        <picker range="{{activities}}" range-key="title" value="{{index}}" bindchange="choose">
          <view>{{index < 0 ? '请选择活动' : activities[index].title}}</view>
        </picker>
        <textarea placeholder="填写培训经历" value="{{description}}" bindinput="input" />
        <button class="primary" loading="{{busy}}" bindtap="submit">提交审核</button>
      </view>
      <view class="section-title">提交记录</view>
      <view class="card" wx:for="{{records}}" wx:key="id">
        <view class="title">{{item.title}}</view>
        <view class="line">{{item.description}}</view>
        <view class="line">
          {{item.status === 'pending' ? '待审核' : item.status === 'approved' ? '已通过' : '未通过'}}
        </view>
        <view class="muted" wx:if="{{item.reviewNote}}">审核意见：{{item.reviewNote}}</view>
      </view>
    </view>
  </scroll-view>
</view>
