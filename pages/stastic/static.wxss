.statistics-tabs {
  display: flex;
  gap: 8rpx;
  padding: 8rpx;
  background: #eaf0fa;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}
.statistics-tab {
  flex: 1;
  padding: 20rpx 4rpx;
  text-align: center;
  font-size: 25rpx;
  color: #54647a;
  border-radius: 14rpx;
}
.statistics-tab.selected {
  background: #25489c;
  color: #fff;
  font-weight: 600;
}
.statistics-toolbar,
.statistics-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.statistics-toolbar button,
.statistics-search button {
  margin: 0;
  flex-shrink: 0;
}
.statistics-year {
  font-size: 36rpx;
  font-weight: 600;
}
.statistics-search {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.statistics-search input {
  flex: 1;
  min-width: 0;
}
.statistics-summary {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin: 24rpx 0;
}
.summary-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx;
}
.summary-number {
  font-size: 44rpx;
  font-weight: 700;
  color: #25489c;
  margin-bottom: 8rpx;
}
.statistics-note {
  margin-bottom: 24rpx;
  line-height: 1.8;
}
.statistics-breadcrumb {
  margin: 24rpx 0;
}
.statistics-breadcrumb button {
  margin: 0 0 16rpx;
}
.statistics-name {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
  flex: 1;
  min-width: 0;
}
.statistics-heading .title {
  margin: 0;
  min-width: 0;
  word-break: break-all;
}
.statistics-hours {
  color: #25489c;
  white-space: nowrap;
  font-weight: 600;
  font-size: 27rpx;
}
.statistics-counts {
  margin-top: 18rpx;
  line-height: 1.8;
}
.statistics-detail {
  color: #25489c;
  margin-left: 16rpx;
}
.rank-number {
  background: #eaf0fa;
  color: #25489c;
  border-radius: 10rpx;
  padding: 6rpx 12rpx;
  font-size: 24rpx;
}
.statistics-pages {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}
.statistics-pages button {
  flex: 1;
}
