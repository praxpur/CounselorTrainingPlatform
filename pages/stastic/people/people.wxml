<view class="page-shell">
  <navigation-bar title="人员参加情况" back="{{true}}"></navigation-bar>
  <scroll-view scroll-y class="screen">
    <view class="container">
      <status-panel
        loading="{{loading}}"
        error-message="{{errorMessage}}"
        bindretry="load"
      ></status-panel>
      <picker range="{{years}}" value="{{yearIndex}}" bindchange="changeYear"><view class="card">导出年份：{{exportYear}} 年 ›</view></picker>
      <button wx:if="{{selected}}" bindtap="exportData" loading="{{exporting}}" disabled="{{exporting}}">导出该人员年度记录</button>
      <block wx:if="{{!selected}}">
        <view class="page-toolbar">
          <view class="muted">人员报名及参加记录</view>
          <button
            class="button-mini export-button"
            size="mini"
            bindtap="exportData"
            loading="{{exporting}}"
            disabled="{{exporting}}"
          >
            导出 Excel
          </button>
        </view>
        <input placeholder="搜索工号、姓名或学院" value="{{query}}" bindinput="search" />
        <view class="muted">已加载 {{visiblePeople.length}} / {{total}} 人</view>
        <view
          class="card"
          wx:for="{{visiblePeople}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="select"
        >
          <view class="title">{{item.name}} · {{item.department}}</view>
          <view class="muted">
            工号 {{item.id}}　历史报名 {{item.registeredCount}} 次 · 历史确认
            {{item.confirmedCount}} 次
            · 自行提交 {{item.externalSubmittedCount}} 次（通过 {{item.externalApprovedCount}} 次）
          </view>
        </view>
        <view class="muted" wx:if="{{!loading && !errorMessage && !visiblePeople.length}}">
          暂无匹配人员
        </view>
      </block>
      <block wx:else>
        <button bindtap="back">返回人员列表</button>
        <view class="heading">{{selected.name}} 的报名记录</view>
        <view class="card" wx:for="{{records}}" wx:key="id">
          <view class="title">{{item.title}}</view>
          <view class="muted">{{item.startsText}} · {{item.locationText}}</view>
          <view class="line">
            {{item.external ? '自行参加 · ' + item.reviewLabel : item.status === 'cancelled' ? '活动已取消' : item.confirmedAt ? '已确认参加' :
            '已报名，待确认参加'}}
          </view>
        </view>
        <view class="muted" wx:if="{{!loading && !errorMessage && !records.length}}">
          暂无报名记录
        </view>
      </block>
      <view class="muted" wx:if="{{!selected && windowed}}">显示第 {{displayFrom}}—{{displayTo}} 人，可返回上一页。</view>
      <button wx:if="{{!selected && previousOffset !== null && previousOffset !== undefined}}" bindtap="previous" disabled="{{loading}}">上一页人员</button>
      <view class="muted" wx:if="{{selected && recordWindowed}}">显示第 {{recordDisplayFrom}}—{{recordDisplayTo}} 条，可返回上一页。</view>
      <button wx:if="{{selected && recordPreviousOffset !== null && recordPreviousOffset !== undefined}}" bindtap="previousRecords" disabled="{{loading}}">上一页记录</button>
      <button wx:if="{{!selected && hasMore}}" bindtap="more" disabled="{{loading}}">加载更多人员</button>
      <button wx:if="{{selected && recordHasMore}}" bindtap="moreRecords" disabled="{{loading}}">加载更早记录</button>
    </view>
  </scroll-view>
</view>
