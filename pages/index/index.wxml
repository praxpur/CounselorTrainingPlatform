<view class="page-shell">
  <navigation-bar
    title="{{user && user.role === 'admin' ? '管理工作台' : '辅导员培训平台'}}"
    back="{{false}}"
  ></navigation-bar>
  <scroll-view scroll-y class="screen">
    <view class="container">
      <status-panel
        loading="{{loading}}"
        error-message="{{errorMessage}}"
        bindretry="onShow"
      ></status-panel>
      <block wx:if="{{!loading && user && user.role === 'admin'}}">
        <school-brand title="管理工作台"></school-brand>
        <view class="campus-hero admin-campus">
          <image
            class="campus-photo"
            src="/assets/brand/shenghua-square.jpg"
            mode="aspectFill"
          ></image>
          <view class="campus-caption">济南大学 · 升华广场</view>
        </view>
        <view class="admin-greeting">您好，{{user.name}} · {{user.department}}</view>
        <view class="section-title">管理与统计</view>
        <view class="admin-menu">
          <navigator class="admin-item" url="/pages/admin/admin">
            <view class="admin-icon blue">
              <image
                class="admin-icon-image"
                src="/assets/admin/activities.png"
                mode="aspectFit"
              ></image>
            </view>
            <view class="admin-content">
              <view class="title">活动管理</view>
              <view class="muted">发布、编辑活动，查看报名名单</view>
            </view>
            <view class="arrow">›</view>
          </navigator>
          <navigator class="admin-item" url="/pages/stastic/people/people">
            <view class="admin-icon green">
              <image
                class="admin-icon-image"
                src="/assets/admin/participation.png"
                mode="aspectFit"
              ></image>
            </view>
            <view class="admin-content">
              <view class="title">人员报名情况</view>
              <view class="muted">按人员查看报名和参加记录</view>
            </view>
            <view class="arrow">›</view>
          </navigator>
          <navigator class="admin-item" url="/pages/users/users">
            <view class="admin-icon green">
              <image
                class="admin-icon-image"
                src="/assets/admin/users.png"
                mode="aspectFit"
              ></image>
            </view>
            <view class="admin-content">
              <view class="title">用户名单管理</view>
              <view class="muted">新增、编辑和停用辅导员</view>
            </view>
            <view class="arrow">›</view>
          </navigator>
          <navigator class="admin-item" url="/pages/stastic/static">
            <view class="admin-icon orange">
              <image
                class="admin-icon-image"
                src="/assets/admin/ranking.png"
                mode="aspectFit"
              ></image>
            </view>
            <view class="admin-content">
              <view class="title">年度统计与排名</view>
              <view class="muted">查看年度参加次数和学时排名</view>
            </view>
            <view class="arrow">›</view>
          </navigator>
          <navigator class="admin-item" url="/pages/reviews/reviews">
            <view class="admin-icon purple">
              <image
                class="admin-icon-image"
                src="/assets/admin/reviews.png"
                mode="aspectFit"
              ></image>
            </view>
            <view class="admin-content">
              <view class="review-heading">
                <view class="title">培训经历审核</view>
                <text class="review-badge" wx:if="{{pendingCount > 0}}">{{pendingCount}}</text>
              </view>
              <view class="muted">审核老师提交的培训经历</view>
            </view>
            <view class="arrow">›</view>
          </navigator>
        </view>
        <button class="logout" bindtap="logout">退出登录</button>
        <view class="school-footer">济南大学学生工作处</view>
      </block>
      <block wx:elif="{{!loading && user}}">
        <school-brand></school-brand>
        <view class="campus-hero home-campus">
          <image
            class="campus-photo"
            src="/assets/brand/shenghua-square.jpg"
            mode="aspectFill"
          ></image>
          <view class="campus-caption">济南大学 · 升华广场</view>
        </view>
        <view class="heading">您好，{{user.name}}</view>
        <view class="muted">{{user.department}} · 辅导员培训</view>
        <view class="row">
          <view class="section-title">培训活动</view>
          <text bindtap="more">全部 ›</text>
        </view>
        <view class="card" wx:for="{{activities}}" wx:key="id" data-id="{{item.id}}" bindtap="open">
          <view class="title">{{item.title}}</view>
          <view class="muted">{{item.startsText}} · {{item.locationText}}</view>
          <view class="muted">已报名 {{item.registeredCount}} / {{item.capacityText}}</view>
          <view class="muted">{{item.activityState}} · {{item.registrationText}}</view>
        </view>
        <view class="muted" wx:if="{{!errorMessage && !activities.length}}">暂无活动</view>
      </block>
    </view>
  </scroll-view>
</view>
