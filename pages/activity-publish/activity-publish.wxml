<view class="page-shell">
  <navigation-bar title="{{editing ? '编辑活动' : '活动发布'}}" back="{{true}}"></navigation-bar>
  <scroll-view scroll-y class="screen">
    <view class="container">
      <status-panel
        loading="{{loading}}"
        error-message="{{errorMessage}}"
        bindretry="load"
      ></status-panel>
      <view class="card" wx:if="{{ready}}">
        <view class="field-label">
          <text class="required-mark">*</text>
          活动名称
        </view>
        <input
          maxlength="100"
          placeholder="请输入活动名称"
          value="{{form.title}}"
          data-field="title"
          bindinput="input"
        />
        <view class="field-label">
          活动地点
          <text class="optional-hint">（可选）</text>
        </view>
        <input
          maxlength="200"
          placeholder="选填，留空显示地点待定"
          value="{{form.location}}"
          data-field="location"
          bindinput="input"
        />
        <view class="field-label">
          活动介绍
          <text class="optional-hint">（可选）</text>
        </view>
        <textarea
          maxlength="2000"
          placeholder="选填，补充活动内容或注意事项"
          value="{{form.description}}"
          data-field="description"
          bindinput="input"
        />
        <view class="field-label">
          <text class="required-mark">*</text>
          开始时间
        </view>
        <view class="row">
          <picker mode="date" value="{{form.startDate}}" data-field="startDate" bindchange="input">
            {{form.startDate || '选择日期'}}
          </picker>
          <picker mode="time" value="{{form.startTime}}" data-field="startTime" bindchange="input">
            {{form.startTime || '选择时间'}}
          </picker>
        </view>
        <view class="field-label">
          <text class="required-mark">*</text>
          结束时间
        </view>
        <view class="row">
          <picker mode="date" value="{{form.endDate}}" data-field="endDate" bindchange="input">
            {{form.endDate || '选择日期'}}
          </picker>
          <picker mode="time" value="{{form.endTime}}" data-field="endTime" bindchange="input">
            {{form.endTime || '选择时间'}}
          </picker>
        </view>
        <view class="field-label">
          <text class="required-mark">*</text>
          活动学时
        </view>
        <input
          type="digit"
          placeholder="请输入统一认定的学时数"
          value="{{form.creditHours}}"
          data-field="creditHours"
          bindinput="input"
        />
        <view class="field-label">
          报名人数上限
          <text class="optional-hint">（可选）</text>
        </view>
        <input
          type="number"
          placeholder="选填，留空表示不限人数"
          value="{{form.capacity}}"
          data-field="capacity"
          bindinput="input"
        />
        <view class="field-label">是否设置签到</view>
        <switch checked="{{form.attendanceEnabled}}" data-field="attendanceEnabled" bindchange="input" />
        <view class="muted">开启后，请在活动管理中设置并开放签到；管理员仍需确认参加后认定学时。</view>
        <button
          class="primary"
          bindtap="save"
          loading="{{busy}}"
          disabled="{{busy || loading || !ready}}"
        >
          {{editing ? '保存修改' : '发布活动'}}
        </button>
        <button bindtap="reset">取消</button>
      </view>
    </view>
  </scroll-view>
</view>
