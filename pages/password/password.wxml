<view class="page-shell">
  <navigation-bar title="修改密码" back="{{true}}"></navigation-bar>
  <scroll-view scroll-y class="screen">
    <view class="container">
      <view class="card">
        <view class="title">设置个人密码</view>
        <view class="muted">首次登录须修改学校发放的初始密码。修改后，其他设备的登录会失效。</view>
        <view class="field-label">原密码 / 初始密码</view>
        <input password maxlength="128" value="{{oldPassword}}" data-field="oldPassword" bindinput="input" />
        <view class="field-label">新密码（12—128 位）</view>
        <input password maxlength="128" value="{{newPassword}}" data-field="newPassword" bindinput="input" />
        <view class="field-label">再次输入新密码</view>
        <input password maxlength="128" value="{{confirmPassword}}" data-field="confirmPassword" bindinput="input" />
        <button class="primary" bindtap="save" loading="{{busy}}" disabled="{{busy || !oldPassword || !newPassword || !confirmPassword}}">保存密码</button>
      </view>
    </view>
  </scroll-view>
</view>
