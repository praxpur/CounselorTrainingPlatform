<view class="page-shell">
  <navigation-bar title="用户名单管理" back="{{true}}"></navigation-bar>
  <scroll-view scroll-y class="screen" scroll-into-view="{{scrollTarget}}">
    <view class="container">
      <status-panel
        loading="{{loading}}"
        error-message="{{errorMessage}}"
        bindretry="load"
      ></status-panel>
      <view class="page-toolbar">
        <navigator url="/pages/user-import/user-import">批量导入名单 ›</navigator>
        <view class="title">辅导员名单</view>
        <button size="mini" class="button-mini primary" bindtap="create">新增用户</button>
      </view>
      <view class="card" wx:if="{{formVisible}}" id="user-editor">
        <view class="title">{{resetting ? '重置初始密码' : editing ? '编辑辅导员' : '新增辅导员'}}</view>
        <view class="muted">工号保存后不可修改；停用用户会保留报名记录。</view>
        <input
          maxlength="40"
          placeholder="工号（字母、数字、下划线或连字符）"
          value="{{form.id}}"
          disabled="{{editing}}"
          data-field="id"
          bindinput="input"
        />
        <input
          maxlength="50"
          placeholder="姓名"
          disabled="{{resetting}}"
          value="{{form.name}}"
          data-field="name"
          bindinput="input"
        />
        <input
          maxlength="100"
          placeholder="学院 / 部门"
          disabled="{{resetting}}"
          value="{{form.department}}"
          data-field="department"
          bindinput="input"
        />
        <block wx:if="{{!editing || resetting}}">
          <input password maxlength="128" placeholder="初始密码（12—128 位）" value="{{form.initialPassword}}" data-field="initialPassword" bindinput="input" />
          <view class="muted">首次登录须修改初始密码；重置将撤销所有旧会话。</view>
        </block>
        <button class="primary" bindtap="save" loading="{{busy}}">
          {{resetting ? '确认重置密码' : editing ? '保存修改' : '添加用户'}}
        </button>
        <button bindtap="reset">取消</button>
      </view>

      <view class="search">
        <input
          placeholder="搜索工号、姓名或部门"
          value="{{query}}"
          bindinput="searchInput"
          confirm-type="search"
          bindconfirm="load"
        />
        <button class="button-mini" size="mini" bindtap="load">搜索</button>
      </view>
      <view class="card" wx:for="{{users}}" wx:key="id">
        <view class="title">
          {{item.name}}
          <text class="status {{!item.enabled ? 'disabled' : ''}}">
            {{item.enabled ? '· 已启用' : '· 已停用'}}
          </text>
        </view>
        <view class="muted">工号：{{item.id}} · {{item.department}}</view>
        <view class="actions">
          <button class="button-mini" size="mini" data-id="{{item.id}}" bindtap="edit">编辑</button>
          <button class="button-mini" size="mini" data-id="{{item.id}}" bindtap="resetAccount">重置密码</button>
          <button class="button-mini" size="mini" data-id="{{item.id}}" bindtap="toggle">
            {{item.enabled ? '停用' : '启用'}}
          </button>
        </view>
      </view>
      <view class="muted" wx:if="{{!loading && !errorMessage && !users.length}}">暂无匹配用户</view>
      <view class="muted" wx:if="{{windowed}}">当前显示第 {{displayFrom}}—{{displayTo}} 条，可返回上一页。</view>
      <button wx:if="{{previousOffset !== null && previousOffset !== undefined}}" bindtap="previous" disabled="{{loading || busy || uploading}}">上一页</button>
      <button wx:if="{{hasMore}}" bindtap="more" disabled="{{loading || busy || uploading}}">加载更多（{{users.length}} / {{total}}）</button>
    </view>
  </scroll-view>
</view>
