.actions {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  margin-top: 20rpx;
}
.actions button {
  margin: 0;
}
.search {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.search input {
  flex: 1;
  min-width: 0;
  width: 0;
}
.status {
  color: #64748b;
}
.disabled {
  color: #d68a27;
}
