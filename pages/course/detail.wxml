<view class="page-shell">
  <navigation-bar title="活动详情" back="{{true}}"></navigation-bar>
  <scroll-view scroll-y class="screen">
    <status-panel
      loading="{{loading}}"
      error-message="{{errorMessage}}"
      bindretry="load"
    ></status-panel>
    <view class="container" wx:if="{{activity}}">
      <view class="card">
        <view class="heading">{{activity.title}}</view>
        <view class="line">时间：{{activity.startsText}} 至 {{activity.endsText}}</view>
        <view class="line">地点：{{activity.locationText}}</view>
        <view class="line">活动学时：{{activity.creditHours}} 学时</view>
        <view class="line">报名：{{activity.registeredCount}} / {{activity.capacityText}}</view>
        <view class="line">
          状态：{{activity.status === 'cancelled' ? '已取消' : activity.confirmedAt ? '已确认参加' :
          activity.registered ? '已报名' : '未报名'}}
        </view>
      </view>
      <view class="card">
        <view class="title">活动介绍</view>
        <view class="line">{{activity.description || '暂无介绍'}}</view>
      </view>
      <navigator wx:if="{{activity.registered && activity.status !== 'cancelled'}}" class="card" url="/pages/attendance/attendance?id={{activity.id}}">活动签到 / 签退 ›</navigator>
      <button
        class="primary"
        disabled="{{!activity.canRegister || busy}}"
        loading="{{busy}}"
        bindtap="register"
      >
        {{activity.registered ? '已报名' : activity.canRegister ? '报名参加' :
        activity.registrationText}}
      </button>
    </view>
  </scroll-view>
</view>
