<view class="page-shell">
  <navigation-bar title="活动中心" back="{{false}}"></navigation-bar>
  <scroll-view scroll-y class="screen">
    <view class="container">
      <status-panel
        loading="{{loading}}"
        error-message="{{errorMessage}}"
        bindretry="load"
      ></status-panel>
      <navigator class="card" wx:if="{{isCounselor}}" url="/pages/self-training/self-training">
        <view class="title">提交自行参加的活动 ›</view>
        <view class="muted">平台之外的培训，可上传参加证明并申请学时。</view>
      </navigator>
      <picker
        class="activity-year"
        mode="selector"
        range="{{yearOptions}}"
        value="{{yearIndex}}"
        bindchange="changeYear"
      >
        <view class="activity-year-label">活动年度</view>
        <view class="activity-year-value">{{yearOptions[yearIndex]}} ⌄</view>
      </picker>
      <view class="card" wx:for="{{activities}}" wx:key="id" data-id="{{item.id}}" bindtap="open">
        <view class="title">{{item.title}}</view>
        <view class="muted">{{item.startsText}} · {{item.locationText}}</view>
        <view class="muted">
          报名 {{item.registeredCount}} / {{item.capacityText}}　{{item.registered ? '已报名' : ''}}
        </view>
        <view class="muted">{{item.activityState}} · {{item.registrationText}}</view>
      </view>
      <view class="muted" wx:if="{{!loading && !errorMessage && !activities.length}}">
        所选年度暂无活动
      </view>
      <view class="muted" wx:if="{{windowed}}">当前显示第 {{displayFrom}}—{{displayTo}} 条，可返回上一页。</view>
      <button wx:if="{{previousOffset !== null && previousOffset !== undefined}}" bindtap="previous" disabled="{{loading || busy || uploading}}">上一页</button>
      <button wx:if="{{hasMore}}" bindtap="more" disabled="{{loading || busy || uploading}}">加载更多（{{activities.length}} / {{total}}）</button>
    </view>
  </scroll-view>
</view>
