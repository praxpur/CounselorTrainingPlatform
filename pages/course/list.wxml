<view class="page-shell">
  <navigation-bar title="培训活动" back="{{false}}"></navigation-bar>
  <scroll-view scroll-y class="screen">
    <view class="container">
      <status-panel
        loading="{{loading}}"
        error-message="{{errorMessage}}"
        bindretry="load"
      ></status-panel>
      <picker
        class="activity-year"
        mode="selector"
        range="{{yearOptions}}"
        value="{{yearIndex}}"
        bindchange="changeYear"
      >
        <view class="activity-year-label">活动年度</view>
        <view class="activity-year-value">{{yearOptions[yearIndex]}} ⌄</view>
      </picker>
      <view class="card" wx:for="{{activities}}" wx:key="id" data-id="{{item.id}}" bindtap="open">
        <view class="title">{{item.title}}</view>
        <view class="muted">{{item.startsText}} · {{item.locationText}}</view>
        <view class="muted">
          报名 {{item.registeredCount}} / {{item.capacityText}}　{{item.registered ? '已报名' : ''}}
        </view>
        <view class="muted">{{item.activityState}} · {{item.registrationText}}</view>
      </view>
      <view class="muted" wx:if="{{!loading && !errorMessage && !activities.length}}">
        所选年度暂无活动
      </view>
    </view>
  </scroll-view>
</view>
