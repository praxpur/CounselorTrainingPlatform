<view class="page-shell">
  <navigation-bar title="登录" back="{{false}}"></navigation-bar>
  <scroll-view scroll-y class="screen">
    <view class="container">
      <school-brand></school-brand>
      <view class="campus-hero login-campus">
        <image
          class="campus-photo"
          src="/assets/brand/shenghua-square.jpg"
          mode="aspectFill"
        ></image>
        <view class="campus-caption">济南大学 · 升华广场</view>
      </view>
      <view class="card login-panel">
        <view class="title">登录培训平台</view>
        <view class="muted">查看培训活动，记录成长历程</view>
        <view class="field-label">工号</view>
        <input maxlength="40" placeholder="请输入学校导入的工号" data-field="id" bindinput="input" />
        <view class="field-label">密码</view>
        <input password maxlength="128" value="{{password}}" placeholder="请输入密码" data-field="password" bindinput="input" />
        <button
          class="primary"
          loading="{{loading}}"
          disabled="{{loading || !id || !password}}"
          bindtap="login"
        >
          登录
        </button>
        <view class="login-hint">首次登录使用学校发放的初始密码；忘记密码请联系管理员。</view>
      </view>
      <view class="school-footer">济南大学学生工作处</view>
    </view>
  </scroll-view>
</view>
