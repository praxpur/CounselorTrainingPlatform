/* 优先使用简体中文字体，避免跨地区字形回退。 */
page {
  display: flex;
  flex-direction: column;
  height: 100%;
  background: #f5f6fa;
  color: #252a3a;
  font-family:
    "Microsoft YaHei", "PingFang SC", "Noto Sans CJK SC", "Source Han Sans SC",
    sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}
view,
text,
navigator,
button,
input,
textarea,
picker {
  box-sizing: border-box;
  font-family: inherit;
}
navigation-bar {
  display: block;
  flex-shrink: 0;
}
/* 导航栏占用高度后，滚动区只填充剩余空间。 */
.page-shell {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
}
.screen {
  flex: 1;
  height: 100%;
  min-height: 0;
  width: 100%;
}
.container {
  width: 100%;
  padding: 24rpx 28rpx 48rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}
.card {
  display: block;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin: 20rpx 0;
}
.heading {
  font-size: 38rpx;
  font-weight: 600;
  margin: 12rpx 0;
  line-height: 1.4;
}
.title,
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
  word-break: break-all;
}
.section-title {
  margin: 24rpx 0 16rpx;
}
.muted {
  color: #737b8d;
  font-size: 26rpx;
  margin-top: 12rpx;
  word-break: break-all;
}
.line {
  margin: 18rpx 0;
  word-break: break-all;
  white-space: pre-wrap;
}
.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  margin: 18rpx 0;
}
.row > picker {
  flex: 1;
  min-width: 0;
}
.row > input {
  flex: 1;
  min-width: 0;
  width: 0;
}
.notice {
  color: #925b18;
  background: #fff4db;
  padding: 20rpx;
  margin: 20rpx 0;
  border-radius: 12rpx;
}
button {
  display: block;
  width: 100%;
  margin: 20rpx 0 0;
  padding: 0 24rpx;
  border-radius: 12rpx;
  background: #eef1f8;
  color: #38445f;
  font-size: 28rpx;
  line-height: 84rpx;
  text-align: center;
}
button::after {
  border: none;
}
button.primary {
  background: #25489c;
  color: #fff;
}

.button-mini {
  display: inline-block;
  width: auto;
  flex-shrink: 0;
  padding: 0 22rpx;
  margin: 8rpx 12rpx 8rpx 0;
  font-size: 26rpx;
  line-height: 68rpx;
}
.export-button {
  color: #25489c;
  background: #eaf0fa;
  margin: 0;
  font-size: 24rpx;
  line-height: 64rpx;
  padding: 0 20rpx;
}
input {
  width: 100%;
  height: 96rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #e8eaf0;
  font-size: 28rpx;
}
textarea {
  width: 100%;
  height: 192rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e8eaf0;
  font-size: 28rpx;
  line-height: 1.6;
}
picker {
  display: block;
  background: #f3f5fa;
  padding: 18rpx;
  border-radius: 10rpx;
}
.field-label {
  display: block;
  margin-top: 22rpx;
  color: #4d576b;
  font-size: 26rpx;
}
.actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}
.page-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 12rpx 0 20rpx;
}
.empty {
  padding: 60rpx 20rpx;
  text-align: center;
  color: #737b8d;
}

/* 校园照片与文字分层，校徽在独立的白底身份区保持原比例。 */
.campus-hero {
  position: relative;
  width: 100%;
  overflow: hidden;
  border-radius: 20rpx;
  background: #e6edf5;
}
.campus-photo {
  display: block;
  width: 100%;
  height: 100%;
}
.campus-caption {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 26rpx 24rpx 20rpx;
  background: linear-gradient(transparent, rgba(12, 32, 62, 0.72));
  color: #fff;
  font-size: 23rpx;
}
.school-footer {
  color: #8993a6;
  font-size: 23rpx;
  text-align: center;
  padding: 32rpx 0 8rpx;
}

.review-heading {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
}
.review-badge {
  display: inline-block;
  min-width: 38rpx;
  padding: 0 12rpx;
  border-radius: 22rpx;
  background: #d93025;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 38rpx;
  text-align: center;
}
